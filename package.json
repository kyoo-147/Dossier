{
  "name": "dossier",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "benchmark": "pnpm --filter @dossier/benchmark bench",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "desktop": "pnpm --filter @dossier/desktop dev",
    "desktop:tauri": "node ./tooling/scripts/run-powershell.mjs ./tooling/scripts/dev.ps1 -Tauri",
    "runtime": "node ./tooling/scripts/run-powershell.mjs ./tooling/scripts/runtime.ps1",
    "demo": "node ./tooling/scripts/run-powershell.mjs ./tooling/scripts/run-demo.ps1",
    "evidence": "node ./tooling/scripts/collect-release-evidence.mjs",
    "sales:packet": "node ./tooling/scripts/write-sales-packet.mjs",
    "test": "pnpm -r --if-present test",
    "test:all": "node ./tooling/scripts/run-powershell.mjs ./tooling/scripts/test.ps1",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dev": "pnpm -r --parallel --if-present dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200"
  }
}
