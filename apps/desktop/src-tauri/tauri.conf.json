{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dossier",
  "version": "0.1.0",
  "identifier": "com.dossier.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "beforeDevCommand": "pnpm --dir ../.. --filter @dossier/desktop dev --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dossier",
        "width": 1440,
        "height": 960,
        "minWidth": 1440,
        "minHeight": 960,
        "resizable": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
