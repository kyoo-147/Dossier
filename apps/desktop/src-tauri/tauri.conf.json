{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dossier",
  "version": "0.1.0",
  "identifier": "com.dossier.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir .. build",
    "beforeDevCommand": "pnpm --dir .. dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dossier",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
